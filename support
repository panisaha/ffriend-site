<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Support - My Study Planner</title>
    <link rel="icon" type="image/png" href="icon-192x192.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-main: #050505; --bg-card: #111111; --burgundy-dark: #2a050a;
            --burgundy-light: #5c0e1b; --cream: #e8e0d0; --beige: #a89b8c; --hanai: #7a3e28;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: var(--bg-main); color: var(--cream); display: flex; justify-content: center; min-height: 100vh; padding: 20px; }
        
        .app-wrapper { width: 100%; max-width: 900px; display: flex; flex-direction: column; gap: 20px; }

        /* نوار منو (کپی شده از بقیه صفحات) */
        .navbar { display: flex; justify-content: center; gap: 15px; flex-wrap: wrap; margin-bottom: 10px; }
        .nav-btn {
            background-color: var(--bg-card); color: var(--beige); text-decoration: none;
            padding: 10px 20px; border-radius: 12px; border: 1px solid var(--burgundy-dark);
            display: flex; align-items: center; gap: 8px; font-weight: bold; transition: all 0.3s ease;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
        }
        .nav-btn:hover { background-color: var(--burgundy-dark); color: var(--cream); transform: translateY(-2px); }
        .nav-btn.active { background-color: var(--burgundy-light); color: var(--cream); border-color: var(--cream); box-shadow: 0 0 15px rgba(92, 14, 27, 0.6); }

        /* استایل کادر پشتیبانی */
        .support-container {
            background-color: var(--bg-card); border: 1px solid var(--burgundy-dark);
            border-radius: 15px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            max-width: 600px; margin: 0 auto; width: 100%; text-align: center;
        }
        .support-container h2 { color: var(--cream); margin-bottom: 10px; font-size: 1.8rem; }
        .support-container p { color: var(--beige); margin-bottom: 25px; font-size: 0.95rem; }

        .form-group { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; text-align: left; }
        .form-group label { color: var(--beige); font-weight: bold; font-size: 0.9rem; }
        
        .form-control {
            width: 100%; padding: 14px 18px; background-color: #0a0a0a; 
            border: 1px solid #222; border-radius: 10px; color: var(--cream); 
            outline: none; font-size: 1rem; transition: all 0.3s ease;
            font-family: inherit;
        }
        .form-control:focus { border-color: var(--burgundy-light); background-color: #111; box-shadow: 0 0 15px rgba(92, 14, 27, 0.3); }
        textarea.form-control { resize: vertical; min-height: 120px; }

        .btn-send {
            background-color: var(--burgundy-light); color: var(--cream); 
            border: 1px solid var(--burgundy-dark); padding: 14px 25px; 
            border-radius: 10px; cursor: pointer; font-weight: bold; 
            font-size: 1.1rem; transition: 0.3s; width: 100%;
            display: flex; justify-content: center; align-items: center; gap: 10px;
        }
        .btn-send:hover { background-color: var(--burgundy-dark); transform: scale(1.02); }
    </style>
</head>
<body>

<div class="app-wrapper">
    <!-- منوی سایت -->
    <nav class="navbar">
        <a href="index.html" class="nav-btn"><i class="fa-solid fa-house"></i> Home</a>
        <a href="notes.html" class="nav-btn"><i class="fa-solid fa-book-open"></i> Notes</a>
        <a href="tasks.html" class="nav-btn"><i class="fa-solid fa-list-check"></i> Tasks</a>
        <a href="timer.html" class="nav-btn"><i class="fa-solid fa-clock"></i> Timer</a>
        <a href="links.html" class="nav-btn"><i class="fa-solid fa-link"></i> Links</a>
        <a href="alarm.html" class="nav-btn"><i class="fa-solid fa-bell"></i> Alarm</a>
        <!-- تب پشتیبانی که فعاله -->
        <a href="support.html" class="nav-btn active"><i class="fa-solid fa-headset"></i> Support</a>
    </nav>

    <!-- کادر پشتیبانی -->
    <div class="support-container">
        <h2>پشتیبانی و ارتباط</h2>
        <p>هر سوال، پیشنهاد یا انتقادی داری، همین‌جا برام بنویس. پیامت مستقیم به دستم می‌رسه!</p>

        <!-- این فرم رو باید به یه سرویس مثل Formspree وصل کنی (توضیحات پایین) -->
        <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
            
            <div class="form-group">
                <label for="name">اسم تو</label>
                <input type="text" id="name" name="name" class="form-control" placeholder="اسمت رو بنویس..." required>
            </div>

            <div class="form-group">
                <label for="email">ایمیل تو (برای پاسخ دادن)</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="example@email.com" required>
            </div>

            <div class="form-group">
                <label for="message">پیامت</label>
                <textarea id="message" name="message" class="form-control" placeholder="چی می‌خوای بگی؟" required></textarea>
            </div>

            <button type="submit" class="btn-send">
                <i class="fa-solid fa-paper-plane"></i> ارسال پیام
            </button>
        </form>
    </div>
</div>

</body>
</html>
